NODE_ENV=dev
PORT=3500
DB_URL=postgresql://postgres:pass123@localhost:5431/mydb
JWT_ACCESS_TOKEN_SECRET=replace-with-a-random-secret
JWT_ACCESS_TOKEN_TIME_IN_MS=900000
JWT_REFRESH_TOKEN_SECRET=replace-with-another-random-secret
JWT_REFRESH_TOKEN_TIME_IN_MS=604800000
COOKIE_DOMAIN=localhost
GITHUB_CLIENT_ID=replace-with-your-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-your-oauth-client-secret
# Register this exact public callback URL in your GitHub OAuth App settings.
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback
GITHUB_SUCCESS_REDIRECT_URL=http://localhost:3000/dashboard
GITHUB_FAILURE_REDIRECT_URL=http://localhost:3000/login
